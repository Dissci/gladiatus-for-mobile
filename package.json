{
  "name": "gladiatus-for-mobile",
  "version": "0.0.1",
  "private": true,
  "description": "Unofficial, community-made mobile layout for the Gladiatus browser game. Dev tooling only; the add-on itself has zero dependencies.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "shots": "node scripts/screenshots.mjs",
    "lint": "npx --yes web-ext lint --source-dir src",
    "start": "npx --yes web-ext run --source-dir src",
    "android": "node scripts/android.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "puppeteer": "25.13.0"
  }
}
